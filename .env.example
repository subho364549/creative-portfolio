# ==============================================================================
# Supabase Configuration
# ==============================================================================
# 1. Create a project at https://supabase.com
# 2. Under Settings -> API, copy Project URL and Project API Keys (anon public)
# 3. Paste them below. When left empty, the site automatically uses high-fidelity
#    local starter content with full offline demo admin capabilities!
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Supabase service role key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Site URL for metadata and OpenGraph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

